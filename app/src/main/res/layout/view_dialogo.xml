<?xml version="1.0" encoding="utf-8"?>
<!-- Explicaciones de Kallpa y Muyu: título claro, texto grande y un solo botón. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_soft"
            android:importantForAccessibility="no"
            android:padding="9dp"
            android:src="@drawable/ic_brote" />

        <TextView
            android:id="@+id/dialogoTitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/forest_dark"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/dialogoScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fadeScrollbars="false">

        <TextView
            android:id="@+id/dialogoMensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_dark"
            android:textSize="16sp" />
    </ScrollView>

    <Button
        android:id="@+id/dialogoBoton"
        style="@style/KallpaButton"
        android:layout_marginTop="18dp"
        android:text="Entendido" />
</LinearLayout>
