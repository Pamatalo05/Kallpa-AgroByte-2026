<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_screen">
    <ImageView android:layout_width="match_parent" android:layout_height="78dp" android:layout_gravity="bottom"
        android:scaleType="fitXY" android:src="@drawable/hills" android:contentDescription="" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal"
            android:orientation="vertical" android:paddingStart="30dp" android:paddingEnd="30dp"
            android:paddingTop="26dp" android:paddingBottom="92dp">
            <ImageView android:layout_width="120dp" android:layout_height="108dp" android:src="@drawable/ic_kallpa" android:contentDescription="Logo de Kallpa" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kallpa" android:textColor="@color/forest" android:textSize="33sp" android:textStyle="bold" />
            <TextView style="@style/TitleLarge" android:layout_marginTop="15dp" android:text="@string/register_title" />
            <TextView style="@style/Subtitle" android:layout_marginTop="4dp" android:text="@string/register_subtitle" />
            <EditText android:id="@+id/inputName" style="@style/KallpaInput" android:layout_marginTop="22dp" android:hint="@string/hint_name" android:inputType="textPersonName|textCapWords" android:autofillHints="name" />
            <EditText android:id="@+id/inputEmail" style="@style/KallpaInput" android:layout_marginTop="10dp" android:hint="@string/hint_email" android:inputType="textEmailAddress" android:autofillHints="emailAddress" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp">
                <EditText android:id="@+id/inputPassword" style="@style/KallpaInput" android:paddingEnd="64dp"
                    android:hint="@string/hint_password" android:inputType="textPassword" android:autofillHints="newPassword" />
                <ImageButton android:id="@+id/btnShowPassword" android:layout_width="52dp" android:layout_height="match_parent"
                    android:layout_gravity="end" android:src="@drawable/ic_eye" android:padding="14dp" android:scaleType="centerInside"
                    android:contentDescription="Mostrar u ocultar contraseña" android:background="@android:color/transparent" />
            </FrameLayout>
            <FrameLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp">
                <EditText android:id="@+id/inputConfirm" style="@style/KallpaInput" android:paddingEnd="64dp"
                    android:hint="@string/hint_confirm_password" android:inputType="textPassword" android:autofillHints="newPassword" />
                <ImageButton android:id="@+id/btnShowConfirm" android:layout_width="52dp" android:layout_height="match_parent"
                    android:layout_gravity="end" android:src="@drawable/ic_eye" android:padding="14dp" android:scaleType="centerInside"
                    android:contentDescription="Mostrar u ocultar contraseña" android:background="@android:color/transparent" />
            </FrameLayout>
            <Button android:id="@+id/btnCreate" style="@style/KallpaButton" android:layout_marginTop="24dp" android:text="@string/btn_continue" />
            <Button android:id="@+id/btnBackLogin" android:layout_width="wrap_content" android:layout_height="50dp" android:layout_marginTop="10dp"
                android:text="← Volver al inicio de sesión" android:textColor="@color/forest" android:textAllCaps="false" android:background="@android:color/transparent" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
