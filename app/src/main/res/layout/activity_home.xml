<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio de Kallpa: saludo, parcela activa, acción principal, accesos y barra inferior. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_gravity="bottom"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/hills" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="8dp"
                android:paddingEnd="18dp"
                android:paddingBottom="28dp">

                <!-- Encabezado limpio: marca a la izquierda y un solo botón de cuenta. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_kallpa" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.02"
                            android:text="@string/app_name"
                            android:textColor="@color/forest"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tagline"
                            android:textColor="@color/earth"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnMenu"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_icon_soft"
                        android:contentDescription="Mi cuenta y más opciones"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_home_user" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtHello"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="¡Hola!"
                    android:textColor="@color/forest_dark"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="¿Qué revisamos hoy en tu parcela?"
                    android:textColor="@color/nav_inactive"
                    android:textSize="16sp" />

                <!-- Solo aparece si no hay internet; Kallpa funciona igual. -->
                <TextView
                    android:id="@+id/txtConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="Sin internet: igual puedes usar Kallpa"
                    android:textColor="@color/forest_dark"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- Parcela activa (se lee del teléfono). -->
                <LinearLayout
                    android:id="@+id/btnChangeParcel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_home_parcel"
                    android:clickable="true"
                    android:contentDescription="Cambiar la parcela que estás viendo"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="84dp"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_icon_soft"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        android:src="@drawable/ic_home_plot" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tu parcela"
                            android:textColor="@color/nav_inactive"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/txtParcelName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Mi parcela"
                            android:textColor="@color/forest_dark"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtParcelDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Cultivo · Tamaño · Cantón"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtParcelCount"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Cambiar"
                        android:textColor="@color/forest"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Acción principal: qué sembrar después. -->
                <FrameLayout
                    android:id="@+id/btnRotations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_home_hero"
                    android:clickable="true"
                    android:contentDescription="Ver qué sembrar después de esta cosecha"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_gravity="bottom"
                        android:alpha="0.18"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY"
                        android:src="@drawable/hills" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="128dp"
                        android:orientation="horizontal"
                        android:padding="18dp">

                        <ImageView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_home_hero_icon"
                            android:importantForAccessibility="no"
                            android:padding="12dp"
                            android:src="@drawable/ic_home_rotation" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="¿Qué siembro después?"
                                android:textColor="@color/white"
                                android:textSize="21sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Mira qué cultivo te conviene y cuánto podrías ahorrar en urea."
                                android:textColor="#E5F5D8"
                                android:textSize="14sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginStart="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_home_arrow_white" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="¿Qué quieres revisar?"
                    android:textColor="@color/forest_dark"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnPlotCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="132dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_tile_plot"
                    android:clickable="true"
                    android:contentDescription="Ver, cambiar o añadir tus parcelas"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_plot" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Mis parcelas"
                        android:textColor="@color/forest_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Cambia o añade otra"
                        android:textColor="@color/nav_inactive"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnClimateCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="132dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_tile_climate"
                    android:clickable="true"
                    android:contentDescription="Ver cómo fue el clima en años de El Niño y La Niña"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_weather" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="El Niño y La Niña"
                        android:textColor="@color/forest_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Cómo fue en otros años"
                        android:textColor="@color/nav_inactive"
                        android:textSize="14sp" />
                </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnCalendarCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="132dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_tile_calendar"
                    android:clickable="true"
                    android:contentDescription="Ver el calendario de tu zona"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_calendar" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Calendario"
                        android:textColor="@color/forest_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Qué meses convienen"
                        android:textColor="@color/nav_inactive"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDiaryCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="132dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_home_tile_diary"
                    android:clickable="true"
                    android:contentDescription="Abrir tu bitácora de campo"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_home_diary" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Mi bitácora"
                        android:textColor="@color/forest_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Anota lo que haces"
                        android:textColor="@color/nav_inactive"
                        android:textSize="14sp" />
                </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:text="Kallpa · Hecho por AgroByte"
                    android:textColor="@color/nav_inactive"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <include layout="@layout/view_barra_inferior" />
</LinearLayout>
