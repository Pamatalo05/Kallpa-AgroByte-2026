<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_screen">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="8dp">
        <Button android:id="@+id/btnCompanionBack" android:layout_width="48dp" android:layout_height="50dp"
            android:contentDescription="Volver" android:text="‹" android:textSize="26sp"
            android:background="@android:color/transparent" android:textColor="@color/forest_dark" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/txtCompanionHeading" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Kallpa" android:textSize="21sp"
                android:textStyle="bold" android:textColor="@color/forest_dark" />
            <TextView android:id="@+id/txtCompanionParcel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Parcela activa" android:textSize="12sp"
                android:textColor="@color/muted" />
        </LinearLayout>
        <Button android:id="@+id/btnCompanionHome" android:layout_width="49dp" android:layout_height="50dp"
            android:contentDescription="Inicio" android:text="⌂" android:textSize="25sp"
            android:background="@android:color/transparent" android:textColor="@color/forest_dark" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout android:id="@+id/companionBody" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingStart="20dp" android:paddingEnd="20dp"
            android:paddingTop="12dp" android:paddingBottom="45dp" />
    </ScrollView>
</LinearLayout>
