<resources>
    <style name="Theme.Kallpa" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorPrimaryDark">@color/forest_dark</item>
        <item name="colorAccent">@color/leaf</item>
        <!-- Las barras del sistema son transparentes: ActividadBase deja espacio para ellas. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="alertDialogTheme">@style/KallpaDialogo</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/cream_light</item>
    </style>
    <style name="TitleLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/forest_dark</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Subtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="KallpaInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">17dp</item>
        <item name="android:paddingEnd">17dp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="KallpaButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="KallpaOutlineButton" parent="KallpaButton">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/forest</item>
    </style>

    <!-- Diálogos: tarjeta crema redondeada y botones verdes legibles. -->
    <style name="KallpaDialogo" parent="ThemeOverlay.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="colorAccent">@color/forest</item>
        <item name="android:textColorPrimary">@color/forest_dark</item>
        <item name="android:textColorSecondary">@color/text_dark</item>
        <item name="buttonBarPositiveButtonStyle">@style/KallpaDialogoBoton</item>
        <item name="buttonBarNegativeButtonStyle">@style/KallpaDialogoBotonSecundario</item>
        <item name="buttonBarNeutralButtonStyle">@style/KallpaDialogoBotonSecundario</item>
    </style>
    <style name="KallpaDialogoBoton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/forest</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="KallpaDialogoBotonSecundario" parent="KallpaDialogoBoton">
        <item name="android:textColor">@color/nav_inactive</item>
        <item name="android:textStyle">normal</item>
    </style>

    <!-- Barra inferior -->
    <style name="KallpaNavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
    <style name="KallpaNavIcono">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
    <style name="KallpaNavTexto">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/nav_inactive</item>
    </style>
</resources>
