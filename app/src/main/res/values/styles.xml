<resources>
    <style name="Theme.Kallpa" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/forest</item>
        <item name="colorPrimaryDark">@color/forest_dark</item>
        <item name="colorAccent">@color/leaf</item>
        <item name="android:statusBarColor">@color/forest_dark</item>
        <item name="android:navigationBarColor">@color/cream</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/cream_light</item>
    </style>
    <style name="TitleLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/forest_dark</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Subtitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="KallpaInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">17dp</item>
        <item name="android:paddingEnd">17dp</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:singleLine">true</item>
    </style>
    <style name="KallpaButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">54dp</item>
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="KallpaOutlineButton" parent="KallpaButton">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/forest</item>
    </style>
</resources>
