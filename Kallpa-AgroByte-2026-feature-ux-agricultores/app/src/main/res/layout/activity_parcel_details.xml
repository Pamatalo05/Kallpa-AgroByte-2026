<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen">
    <ImageView android:layout_width="match_parent" android:layout_height="85dp"
        android:layout_gravity="bottom" android:scaleType="fitXY"
        android:src="@drawable/hills" android:contentDescription="@null" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="18dp"
            android:paddingBottom="120dp">
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="← Mis parcelas"
                android:clickable="true"
                android:focusable="true"
                android:textSize="16sp"
                android:textColor="@color/forest" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Mi parcela"
                android:textColor="@color/forest_dark"
                android:textSize="26sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/forest" />
            <TextView
                android:id="@+id/txtData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="20dp"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="9dp"
                android:textSize="15sp"
                android:textColor="@color/text_dark" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="La ubicación indicada pertenece a esta parcela, no al perfil del agricultor. Los datos agrícolas del piloto cubren Daule y Babahoyo."
                android:textColor="@color/muted"
                android:textSize="13sp" />
            <Button
                android:id="@+id/btnSelect"
                style="@style/KallpaButton"
                android:layout_marginTop="24dp"
                android:text="Seleccionar esta parcela" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
